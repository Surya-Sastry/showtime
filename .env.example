# Copy to .env and replace every placeholder locally. Never commit .env.

IDENTITY_POSTGRES_DB=<choose-local-database>
IDENTITY_POSTGRES_USER=<choose-local-user>
IDENTITY_POSTGRES_PASSWORD=<generate-a-local-password>

CATALOG_POSTGRES_DB=<choose-local-database>
CATALOG_POSTGRES_USER=<choose-local-user>
CATALOG_POSTGRES_PASSWORD=<generate-a-local-password>

BOOKING_POSTGRES_DB=<choose-local-database>
BOOKING_POSTGRES_USER=<choose-local-user>
BOOKING_POSTGRES_PASSWORD=<generate-a-local-password>

# Shared HS256 signing key: Identity issues JWTs, Catalog and Booking
# validate them. Generate at least 32 random characters.
JWT_SIGNING_KEY=<generate-at-least-32-random-characters>

# Shared HMAC secret: Mock Payment signs webhook callbacks, Booking
# verifies them. Generate a separate random secret from the JWT key.
PAYMENT_WEBHOOK_SECRET=<generate-a-separate-random-secret>
